  const nuovi=[i1, i2, i3].sort((a, b)=>Carte[a].indice-Carte[b].indice);
  setNumeriUsciti(nuovi);
  setCarteInGioco([Carte[i1],Carte[i2],Carte[i3]]);
  setGiocoIniziato(true);
  setIndice(returnCasuale());
  setErrori(errori=>0);
  setContaCarte(contaCarte=>3);
  };

